{
  "name": "stellix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @stellix/extension dev",
    "build": "pnpm --filter @stellix/extension build",
    "zip": "pnpm --filter @stellix/extension zip",
    "test": "pnpm -r run test",
    "test:testnet": "pnpm -r run test:testnet",
    "test:e2e": "pnpm --filter @stellix/extension test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0 && node scripts/check-lint-restrictions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:mainnet": "pnpm --filter @stellix/extension test:e2e:mainnet"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stellar/stellar-sdk": "17.1.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
