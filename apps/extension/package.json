{
  "name": "@stellix/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "prepare:types": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "test": "wxt prepare && vitest run",
    "test:testnet": "echo 'No testnet tests in apps/extension'",
    "test:e2e": "wxt build && playwright test --grep-invert @mainnet",
    "test:e2e:mainnet": "STELLIX_MAINNET_ENABLED=true wxt build && STELLIX_MAINNET_ENABLED=true playwright test --grep @mainnet"
  },
  "dependencies": {
    "@stellix/core": "workspace:*",
    "qr": "0.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  }
}
