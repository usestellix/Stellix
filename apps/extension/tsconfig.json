{
  // WXT's generated config (paths, DOM libs, wxt.d.ts), then our strict base on top.
  "extends": ["./.wxt/tsconfig.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "e2e",
    "build",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".output"]
}
